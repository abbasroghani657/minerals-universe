generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Product {
  id        Int     @id @default(autoincrement())
  img       String
  mainCat   String?
  cat       String
  name      String
  original  String?
  sale      String
  priceNum  Float
  badge     String
  stock     String?
  desc      String  @db.Text
  origin    String
  treatment String
  cert      String
}

model Order {
  id              String      @id
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String      @db.Text
  total           Float
  paymentMethod   String
  paymentStatus   String
  status          String      @default("Processing")
  tracking        String?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  name     String
  quantity Int
  price    Float
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "OrderItem_orderId_fkey")
}

model Inquiry {
  id             String   @id
  name           String
  email          String
  phone          String?
  type           String
  subject        String
  message        String   @db.Text
  createdAt      DateTime @default(now())
  status         String
  stoneType      String?
  caratWeight    String?
  preferredColor String?
  maxBudget      String?
  intendedUse    String?
}

model Review {
  id        String   @id
  author    String
  product   String
  productId Int?
  rating    Int
  text      String   @db.Text
  status    String
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String
  createdAt DateTime @default(now())
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @db.Text
}

model Bundle {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  badge       String?  @default("Special Offer")
  originalUSD Float
  saleUSD     Float
  imgs        String   @db.Text
  items       String?  @db.Text
  stock       String?  @default("In Stock")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}